// Journal metrics used by the print CV.
// Values are the latest public JCR values verified on 2026-06-10.
// As of this date, the 2026 JCR has not yet been released; the latest formal
// release is the 2025 JCR, reporting 2024 Journal Impact Factors.

#let jif-year = "2024 JIF"
#let jif-anie = "17.0"
#let jif-sci-data = "6.9"
#let jif-chem-asian = "3.3"
#let jif-nat-mach-intell = "23.9"
#let jif-nat-commun = "15.7"
#let jif-chem-eur = "3.7"
#let jif-obc = "2.8"
#let jif-csb = "1.2"
#let jif-synlett = "1.4"

#let impact-factor(value) = [#jif-year: #value]
